# API 地址 - 开发环境
NEXT_PUBLIC_API_URL=http://localhost:8080

# API 地址 - 生产环境（根据实际情况修改）
# NEXT_PUBLIC_API_URL=https://your-api-domain.com

# ===== Supabase（笔记评论）=====
# 在 Supabase 控制台 → Project Settings → API 中获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ============================================================
#  Docker Compose 部署所需变量（docker compose 会自动读取根目录 .env）
#  ⚠️ 复制为 .env 后填入真实值，切勿提交 .env 进仓库
# ============================================================

# 数据库账号密码（MySQL 容器与后端共用）
DB_USER=admin
DB_PASSWORD=请改成强密码

# JWT 签名密钥：至少 32 字符的强随机串
# 生成示例：openssl rand -base64 48
JWT_SECRET=请用 openssl rand -base64 48 生成并替换

# 后端 CORS 白名单（逗号分隔，生产填真实域名）
APP_CORS_ALLOWED_ORIGINS=https://liuxxs.com,https://www.liuxxs.com

# 前端构建时写死的 API 地址（生产填走 nginx 的对外地址）
API_URL=https://liuxxs.com

# ===== 阿里云容器镜像服务（ACR）=====
# CI/CD 推镜像和服务器拉镜像时需要；docker-compose.prod.yml 会引用这两个变量
# 在 ACR 控制台 → 实例详情 → 仓库地址中复制
ACR_REGISTRY=crpi-xxxxxxxxxxxxxx.cn-beijing.personal.cr.aliyuncs.com
ACR_NAMESPACE=isme
